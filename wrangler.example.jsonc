{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "<YOUR_WORKER_NAME>",
  "main": "./dist/index.js",
  "compatibility_date": "2025-03-31",
  "compatibility_flags": [
    "nodejs_compat",
  ],
  "minify": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "<YOUR_CUSTOM_DOMAIN>",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
  },
  "kv_namespaces": [
    {
      "binding": "Redirect_KV",
      "id": "<YOUR_REDIRECT_KV_ID>",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
